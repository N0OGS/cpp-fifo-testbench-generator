# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_DRIVE_FOLDER_ID: Destination Google Drive Folder ID for uploaded C++ testbenches.
GOOGLE_DRIVE_FOLDER_ID="1WN83H2vogNhfc--mbefs-Y9rEajmg65T"

# SERVICE_ACCOUNT_KEY_PATH: Optional path to service account JSON (defaults to ./service-account.json)
SERVICE_ACCOUNT_KEY_PATH="./service-account.json"

# GEMINI_MODEL: Gemini model name for C++ testbench generation (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# TARGET_COUNT: Number of verified C++ testbenches to generate (default: 20)
TARGET_COUNT="20"
